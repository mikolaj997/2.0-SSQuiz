}
decreaseId() {
    if (this.flashcardData.id1 < 10) {
        this.flashcardData.id1--
    }
    if (this.flashcardData.id2 < 10) {
        this.flashcardData.id2--
    }
    if (this.flashcardData.id3 < 10) {
        this.flashcardData.id3--
    }
}
