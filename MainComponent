name = 'ssQuiz'
FlashcardCategory() {
  
    if (this.flashcardData.selectedOption == 'option1') {
        this.flashcardData.showCommon1 = true;
        this.flashcardData.showSport1 = false;
        this.flashcardData.showPollution1 = false;

        this.flashcardData.flashcardCategoryClicked = true
    }
    if (this.flashcardData.selectedOption == 'option2') {
        this.flashcardData.showPollution1 = true;
        this.flashcardData.showSport1 = false;
        this.flashcardData.showCommon1 = false;

        this.flashcardData.flashcardCategoryClicked = true
    }
    if (this.flashcardData.selectedOption == 'option3') {
        this.flashcardData.showSport1 = true;
        this.flashcardData.showCommon1 = false;
        this.flashcardData.showPollution1 = false;

        this.flashcardData.flashcardCategoryClicked = true
    }

}
togglePopup(){
    this.flashcardData.showPopup = !this.flashcardData.showPopup;
}
toggleRotation() {
    this.flashcardData.rotateFiszka = !this.flashcardData.rotateFiszka;
}
showFlashcardInfo(){
    this.flashcardData.showFlashcardInfo1 = !this.flashcardData.showFlashcardInfo1
}
showAllOfWords() {
    this.flashcardData.showAllWords = !this.flashcardData.showAllWords;
}
inscreaseId() {
    if (this.flashcardData.id1 < 9) {
        this.flashcardData.id1++;
    } else {
        this.flashcardData.id1 = 0;
    }
    
    if (this.flashcardData.id2 < 9) {
        this.flashcardData.id2++;
    } else {
        this.flashcardData.id2 = 0;
    }
    
    if (this.flashcardData.id3 < 9) {
        this.flashcardData.id3++;
    } else {
        this.flashcardData.id3 = 0;
    }
